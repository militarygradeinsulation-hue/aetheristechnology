{
  "manifest_version": 3,
  "name": "Lovable Monitor",
  "version": "1.0.0",
  "description": "Monitor Lovable projects in real-time and provide context to the Lovable Optimizer",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "captureVisibleTab"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://lovable.app/*",
    "https://*.lovable.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lovable Monitor"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
