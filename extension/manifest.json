{
  "manifest_version": 3,
  "name": "Aetheris Operator — Forensic Cockpit",
  "version": "0.8.3",
  "description": "Forensic operator that scans any page for revenue leaks, draws an X-ray overlay on the live DOM, records funnel autopsies, and routes every finding to a fix.",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel", "webNavigation"],
  "optional_permissions": ["debugger"],
  "host_permissions": [
    "<all_urls>",
    "https://ihdjpxhcaiaixmqxyqoe.supabase.co/*"
  ],
  "action": {
    "default_title": "Aetheris Operator",
    "default_icon": "icon.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
